# SSH Configuration untuk Sempat VPS

Host sempat-vps
    HostName 145.79.12.217
    User root
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    Compression yes

# Cara pakai:
# ssh sempat-vps                    -> Login ke VPS
# scp file.txt sempat-vps:~/        -> Upload file
# scp sempat-vps:~/file.txt ./      -> Download file
